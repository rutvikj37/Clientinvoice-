# Copy to server/.env and adjust
PORT=4000
# REQUIRED in production: long random string used to sign logins and share links
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of this app (used in WhatsApp / email "view invoice" links)
PUBLIC_URL=http://localhost:4000
# Where the SQLite database and uploads are stored
# DATA_DIR=./data

# Optional fallback SMTP (each company can also set its own in Settings → Email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM=you@gmail.com

# Optional fallback WhatsApp Cloud API (each company can also set its own in Settings → WhatsApp)
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# WA_API_VERSION=v21.0
